# Smart Student Hub Environment Configuration
# FOR 100,000+ STUDENTS PRODUCTION ENVIRONMENT

# ==================== DATABASE CONFIGURATION ====================
DATABASE_URL="your-neon-database-url-here"
DIRECT_URL="your-neon-direct-url-here"

# ==================== SESSION CONFIGURATION ====================
SESSION_SECRET="your-super-secure-session-secret-here"
NODE_ENV="development"

# ==================== FIREBASE CONFIGURATION ====================
# Add your Firebase project credentials here
VITE_FIREBASE_API_KEY="your-firebase-api-key"
VITE_FIREBASE_AUTH_DOMAIN="smart-student-hub.firebaseapp.com"
VITE_FIREBASE_DATABASE_URL="https://smart-student-hub-default-rtdb.firebaseio.com"
VITE_FIREBASE_PROJECT_ID="smart-student-hub"
VITE_FIREBASE_STORAGE_BUCKET="smart-student-hub.appspot.com"
VITE_FIREBASE_MESSAGING_SENDER_ID="123456789"
VITE_FIREBASE_APP_ID="1:123456789:web:abcdef123456"

# ==================== SERVER CONFIGURATION ====================
PORT=5000
CLIENT_URL="http://localhost:5173"

# ==================== REDIS CONFIGURATION (FOR 100K STUDENTS) ====================
REDIS_URL="redis://localhost:6379"
REDIS_PASSWORD=""

# ==================== PERFORMANCE SETTINGS ====================
# Rate limiting for 100k students
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW_MS=60000

# Memory settings
NODE_OPTIONS="--max-old-space-size=4096"

# ==================== MONITORING & ANALYTICS ====================
ENABLE_ANALYTICS=true
LOG_LEVEL="info"

# ==================== EMAIL CONFIGURATION ====================
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_USER="your-email@gmail.com"
SMTP_PASS="your-app-password"

# ==================== FILE UPLOAD SETTINGS ====================
MAX_FILE_SIZE=10485760  # 10MB
UPLOAD_PATH="./uploads"

# ==================== SECURITY SETTINGS ====================
CORS_ORIGINS="http://localhost:5173,https://yourdomain.com"
TRUST_PROXY=true