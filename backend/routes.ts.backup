/**
 * COMPLETE BACKEND API ROUTES FOR SMART STUDENT HUB
 *
 * RESTful API endpoints for ALL platform features:
 * - Authentication & User Management
 * - Academic Management (Courses, Timetable, Grades, Materials)
 * - Financial Management (Fees, Payments, Scholarships)
 * - Campus Life (Library, Hostel, Transportation, Clubs)
 * - Career & Placement
 * - Events & Notices
 * - Support & Grievances
 * - Student Development
 * - Activities & Portfolio
 * - Analytics & Reports
 */

import { Router } from "express";
import type { Express, Request, Response } from "express";
import { db } from "../server/db";
import {
  users,
  courses,
  courseEnrollments,
  timetable,
  grades,
  studyMaterials,
  assignments,
  assignmentSubmissions,
  exams,
  examResults,
  attendance,
  feeStructure,
  feePayments,
  scholarships,
  scholarshipApplications,
  libraryBooks,
  libraryIssues,
  hostelRooms,
  hostelAllotments,
  busRoutes,
  cafeteriaMenu,
  clubs,
  clubMemberships,
  placements,
  placementApplications,
  internships,
  internshipApplications,
  events,
  eventRSVP,
  notices,
  noticeReads,
  lostFound,
  grievances,
  medicalRecords,
  mentorships,
  researchProjects,
  researchParticipants,
  certifications,
  skillAssessments,
  assessmentAttempts,
  activities,
  goals,
  achievements,
  notifications,
  alumni,
} from "./schema";
import {
  eq,
  and,
  desc,
  sql,
  between,
  gte,
  lte,
  like,
  inArray,
} from "drizzle-orm";
import multer from "multer";
import path from "path";

// ==================== MULTER CONFIGURATION ====================

const storage = multer.diskStorage({
  destination: (req, file, cb) => {
    cb(null, "uploads/");
  },
  filename: (req, file, cb) => {
    const uniqueSuffix = Date.now() + "-" + Math.round(Math.random() * 1e9);
    cb(
      null,
      file.fieldname + "-" + uniqueSuffix + path.extname(file.originalname)
    );
  },
});

const upload = multer({
  storage: storage,
  limits: { fileSize: 10 * 1024 * 1024 }, // 10MB limit
});

// ==================== HELPER FUNCTIONS ====================

// Database check middleware - ensures DB is initialized
const requireDb = (req: Request, res: Response, next: Function) => {
  if (!db) {
    return res.status(503).json({
      error: "Database not configured",
      message: "Please configure DATABASE_URL environment variable",
    });
  }
  next();
};

// Authentication middleware
const requireAuth = (req: Request, res: Response, next: Function) => {
  if (!req.session?.user) {
    return res.status(401).json({ error: "Unauthorized - Please login" });
  }
  next();
};

// Role-based authorization
const requireRole = (...roles: string[]) => {
  return (req: Request, res: Response, next: Function) => {
    if (!req.session?.user) {
      return res.status(401).json({ error: "Unauthorized" });
    }
    if (!roles.includes(req.session.user.role)) {
      return res
        .status(403)
        .json({ error: "Forbidden - Insufficient permissions" });
    }
    next();
  };
};

// Type-safe async handler
const asyncHandler = (
  fn: (req: Request, res: Response, next: Function) => Promise<any>
) => {
  return (req: Request, res: Response, next: Function) => {
    Promise.resolve(fn(req, res, next)).catch(next);
  };
};

// ==================== ROUTES SETUP ====================

export function registerRoutes(app: Express) {
  const apiRouter = Router();

  // ==================== AUTHENTICATION & USER MANAGEMENT ====================

  // Get current user profile
  apiRouter.get(
    "/users/me",
    requireDb,
    requireAuth,
    asyncHandler(async (req: Request, res: Response) => {
      const userId = req.session.user!.id;
      const user = await db!.query.users.findFirst({
        where: eq(users.id, userId.toString()),
      });
      res.json(user);
    })
  );

  // Update user profile
  apiRouter.put(
    "/users/me",
    requireAuth,
    asyncHandler(async (req: Request, res: Response) => {
      const {
        firstName,
        lastName,
        phoneNumber,
        address,
        bloodGroup,
        emergencyContact,
      } = req.body;

      const [updatedUser] = await db
        .update(users)
        .set({
          firstName,
          lastName,
          phoneNumber,
          address,
          bloodGroup,
          emergencyContact,
          updatedAt: new Date(),
        })
        .where(eq(users.id, req.session.user.id))
        .returning();

      res.json(updatedUser);
    })
  );

  // Get user by ID (for faculty/admin)
  apiRouter.get(
    "/users/:id",
    requireAuth,
    asyncHandler(async (req: Request, res: Response) => {
      const user = await db.query.users.findFirst({
        where: eq(users.id, req.params.id),
      });
      if (!user) {
        return res.status(404).json({ error: "User not found" });
      }
      res.json(user);
    })
  );

  // List all students (for faculty/admin)
  apiRouter.get(
    "/users",
    requireRole("faculty", "admin"),
    asyncHandler(async (req: Request, res: Response) => {
      const { department, semester, role } = req.query;

      let query = db.select().from(users);
      const conditions = [];

      if (department)
        conditions.push(eq(users.department, department as string));
      if (semester)
        conditions.push(
          eq(users.currentSemester, parseInt(semester as string))
        );
      if (role) conditions.push(eq(users.role, role as any));

      if (conditions.length > 0) {
        query = query.where(and(...conditions)) as any;
      }

      const allUsers = await query;
      res.json(allUsers);
    })
  );

  // ==================== COURSES MANAGEMENT ====================

  // Get all courses
  apiRouter.get(
    "/courses",
    requireAuth,
    asyncHandler(async (req: Request, res: Response) => {
      const { department, semester } = req.query;

      let query = db.select().from(courses);
      const conditions = [];

      if (department)
        conditions.push(eq(courses.department, department as string));
      if (semester)
        conditions.push(eq(courses.semester, parseInt(semester as string)));

      if (conditions.length > 0) {
        query = query.where(and(...conditions)) as any;
      }

      const allCourses = await query;
      res.json(allCourses);
    })
  );

  // Get course by ID
  apiRouter.get(
    "/courses/:id",
    requireAuth,
    asyncHandler(async (req: Request, res: Response) => {
      const course = await db.query.courses.findFirst({
        where: eq(courses.id, req.params.id),
        with: {
          instructor: true,
        },
      });
      if (!course) {
        return res.status(404).json({ error: "Course not found" });
      }
      res.json(course);
    })
  );

  // Create new course (faculty/admin only)
  apiRouter.post(
    "/courses",
    requireRole("faculty", "admin"),
    asyncHandler(async (req: Request, res: Response) => {
      const [newCourse] = await db.insert(courses).values(req.body).returning();
      res.status(201).json(newCourse);
    })
  );

  // Update course
  apiRouter.put(
    "/courses/:id",
    requireRole("faculty", "admin"),
    asyncHandler(async (req: Request, res: Response) => {
      const [updatedCourse] = await db
        .update(courses)
        .set({ ...req.body, updatedAt: new Date() })
        .where(eq(courses.id, req.params.id))
        .returning();
      res.json(updatedCourse);
    })
  );

  // Delete course
  apiRouter.delete(
    "/courses/:id",
    requireRole("admin"),
    asyncHandler(async (req: Request, res: Response) => {
      await db.delete(courses).where(eq(courses.id, req.params.id));
      res.status(204).send();
    })
  );

  // ==================== COURSE ENROLLMENTS ====================

  // Get student's enrolled courses
  apiRouter.get(
    "/enrollments/me",
    requireAuth,
    asyncHandler(async (req: Request, res: Response) => {
      const enrollments = await db
        .select({
          enrollment: courseEnrollments,
          course: courses,
        })
        .from(courseEnrollments)
        .leftJoin(courses, eq(courseEnrollments.courseId, courses.id))
        .where(eq(courseEnrollments.studentId, req.session.user.id));

      res.json(enrollments);
    })
  );

  // Enroll in course
  apiRouter.post(
    "/enrollments",
    requireAuth,
    asyncHandler(async (req: Request, res: Response) => {
      const { courseId } = req.body;

      // Check if already enrolled
      const existing = await db.query.courseEnrollments.findFirst({
        where: and(
          eq(courseEnrollments.studentId, req.session.user.id),
          eq(courseEnrollments.courseId, courseId)
        ),
      });

      if (existing) {
        return res
          .status(400)
          .json({ error: "Already enrolled in this course" });
      }

      // Check course capacity
      const course = await db.query.courses.findFirst({
        where: eq(courses.id, courseId),
      });

      if (!course) {
        return res.status(404).json({ error: "Course not found" });
      }

      if (course.currentEnrollment >= course.maxCapacity) {
        return res.status(400).json({ error: "Course is full" });
      }

      // Create enrollment
      const [enrollment] = await db
        .insert(courseEnrollments)
        .values({
          studentId: req.session.user.id,
          courseId,
          status: "active",
        })
        .returning();

      // Update course enrollment count
      await db
        .update(courses)
        .set({ currentEnrollment: course.currentEnrollment + 1 })
        .where(eq(courses.id, courseId));

      res.status(201).json(enrollment);
    })
  );

  // Drop course
  apiRouter.delete(
    "/enrollments/:id",
    requireAuth,
    asyncHandler(async (req: Request, res: Response) => {
      const enrollment = await db.query.courseEnrollments.findFirst({
        where: eq(courseEnrollments.id, req.params.id),
      });

      if (!enrollment) {
        return res.status(404).json({ error: "Enrollment not found" });
      }

      if (enrollment.studentId !== req.session.user.id) {
        return res.status(403).json({ error: "Forbidden" });
      }

      await db
        .delete(courseEnrollments)
        .where(eq(courseEnrollments.id, req.params.id));

      // Update course enrollment count
      await db.execute(sql`
      UPDATE courses 
      SET current_enrollment = current_enrollment - 1 
      WHERE id = ${enrollment.courseId}
    `);

      res.status(204).send();
    })
  );

  // ==================== TIMETABLE ====================

  // Get student's timetable
  apiRouter.get(
    "/timetable/me",
    requireAuth,
    asyncHandler(async (req: Request, res: Response) => {
      const user = await db.query.users.findFirst({
        where: eq(users.id, req.session.user.id),
      });

      if (!user) {
        return res.status(404).json({ error: "User not found" });
      }

      const schedule = await db
        .select({
          timetable: timetable,
          course: courses,
        })
        .from(timetable)
        .leftJoin(courses, eq(timetable.courseId, courses.id))
        .where(eq(timetable.semester, user.currentSemester));

      res.json(schedule);
    })
  );

  // Get timetable by course
  apiRouter.get(
    "/timetable/course/:courseId",
    requireAuth,
    asyncHandler(async (req: Request, res: Response) => {
      const schedule = await db
        .select()
        .from(timetable)
        .where(eq(timetable.courseId, req.params.courseId));
      res.json(schedule);
    })
  );

  // Create timetable entry (faculty/admin)
  apiRouter.post(
    "/timetable",
    requireRole("faculty", "admin"),
    asyncHandler(async (req: Request, res: Response) => {
      const [entry] = await db.insert(timetable).values(req.body).returning();
      res.status(201).json(entry);
    })
  );

  // Update timetable entry
  apiRouter.put(
    "/timetable/:id",
    requireRole("faculty", "admin"),
    asyncHandler(async (req: Request, res: Response) => {
      const [updated] = await db
        .update(timetable)
        .set(req.body)
        .where(eq(timetable.id, req.params.id))
        .returning();
      res.json(updated);
    })
  );

  // Delete timetable entry
  apiRouter.delete(
    "/timetable/:id",
    requireRole("faculty", "admin"),
    asyncHandler(async (req: Request, res: Response) => {
      await db.delete(timetable).where(eq(timetable.id, req.params.id));
      res.status(204).send();
    })
  );

  // ==================== GRADES ====================

  // Get student's grades
  apiRouter.get(
    "/grades/me",
    requireAuth,
    asyncHandler(async (req: Request, res: Response) => {
      const studentGrades = await db
        .select({
          grade: grades,
          course: courses,
        })
        .from(grades)
        .leftJoin(courses, eq(grades.courseId, courses.id))
        .where(eq(grades.studentId, req.session.user.id))
        .orderBy(desc(grades.examDate));

      res.json(studentGrades);
    })
  );

  // Get grades by semester
  apiRouter.get(
    "/grades/semester/:semester",
    requireAuth,
    asyncHandler(async (req: Request, res: Response) => {
      const semester = parseInt(req.params.semester);

      const studentGrades = await db
        .select({
          grade: grades,
          course: courses,
        })
        .from(grades)
        .leftJoin(courses, eq(grades.courseId, courses.id))
        .where(
          and(
            eq(grades.studentId, req.session.user.id),
            eq(courses.semester, semester)
          )
        );

      res.json(studentGrades);
    })
  );

  // Get CGPA
  apiRouter.get(
    "/grades/cgpa",
    requireAuth,
    asyncHandler(async (req: Request, res: Response) => {
      const user = await db.query.users.findFirst({
        where: eq(users.id, req.session.user.id),
      });
      res.json({ cgpa: user?.cgpa || 0 });
    })
  );

  // Add grade (faculty only)
  apiRouter.post(
    "/grades",
    requireRole("faculty", "admin"),
    asyncHandler(async (req: Request, res: Response) => {
      const [newGrade] = await db.insert(grades).values(req.body).returning();
      res.status(201).json(newGrade);
    })
  );

  // Update grade
  apiRouter.put(
    "/grades/:id",
    requireRole("faculty", "admin"),
    asyncHandler(async (req: Request, res: Response) => {
      const [updated] = await db
        .update(grades)
        .set(req.body)
        .where(eq(grades.id, req.params.id))
        .returning();
      res.json(updated);
    })
  );

  // ==================== STUDY MATERIALS ====================

  // Get study materials by course
  apiRouter.get(
    "/materials/course/:courseId",
    requireAuth,
    asyncHandler(async (req: Request, res: Response) => {
      const materials = await db
        .select()
        .from(studyMaterials)
        .where(eq(studyMaterials.courseId, req.params.courseId))
        .orderBy(desc(studyMaterials.createdAt));
      res.json(materials);
    })
  );

  // Get all materials
  apiRouter.get(
    "/materials",
    requireAuth,
    asyncHandler(async (req: Request, res: Response) => {
      const { category } = req.query;

      let query = db
        .select({
          material: studyMaterials,
          course: courses,
        })
        .from(studyMaterials)
        .leftJoin(courses, eq(studyMaterials.courseId, courses.id));

      if (category) {
        query = query.where(
          eq(studyMaterials.category, category as string)
        ) as any;
      }

      const materials = await query.orderBy(desc(studyMaterials.createdAt));
      res.json(materials);
    })
  );

  // Upload study material
  apiRouter.post(
    "/materials",
    requireAuth,
    upload.single("file"),
    asyncHandler(async (req: Request, res: Response) => {
      if (!req.file) {
        return res.status(400).json({ error: "No file uploaded" });
      }

      const { courseId, title, description, category } = req.body;

      const [material] = await db
        .insert(studyMaterials)
        .values({
          courseId,
          title,
          description,
          category,
          fileUrl: `/uploads/${req.file.filename}`,
          fileName: req.file.originalname,
          fileSize: req.file.size,
          fileType: req.file.mimetype,
          uploadedBy: req.session.user.id,
        })
        .returning();

      res.status(201).json(material);
    })
  );

  // Increment download count
  apiRouter.post(
    "/materials/:id/download",
    requireAuth,
    asyncHandler(async (req: Request, res: Response) => {
      await db.execute(sql`
      UPDATE study_materials 
      SET download_count = download_count + 1 
      WHERE id = ${req.params.id}
    `);
      res.status(200).json({ message: "Download count updated" });
    })
  );

  // Delete material
  apiRouter.delete(
    "/materials/:id",
    requireAuth,
    asyncHandler(async (req: Request, res: Response) => {
      const material = await db.query.studyMaterials.findFirst({
        where: eq(studyMaterials.id, req.params.id),
      });

      if (!material) {
        return res.status(404).json({ error: "Material not found" });
      }

      if (
        material.uploadedBy !== req.session.user.id &&
        req.session.user.role !== "admin"
      ) {
        return res.status(403).json({ error: "Forbidden" });
      }

      await db
        .delete(studyMaterials)
        .where(eq(studyMaterials.id, req.params.id));
      res.status(204).send();
    })
  );

  // ==================== ASSIGNMENTS ====================

  // Get assignments by course
  apiRouter.get(
    "/assignments/course/:courseId",
    requireAuth,
    asyncHandler(async (req: Request, res: Response) => {
      const courseAssignments = await db
        .select()
        .from(assignments)
        .where(eq(assignments.courseId, req.params.courseId))
        .orderBy(desc(assignments.dueDate));
      res.json(courseAssignments);
    })
  );

  // Get all assignments for student
  apiRouter.get(
    "/assignments/me",
    requireAuth,
    asyncHandler(async (req: Request, res: Response) => {
      // Get enrolled courses
      const enrolledCourses = await db
        .select({ courseId: courseEnrollments.courseId })
        .from(courseEnrollments)
        .where(eq(courseEnrollments.studentId, req.session.user.id));

      const courseIds = enrolledCourses.map((e) => e.courseId);

      const allAssignments = await db
        .select({
          assignment: assignments,
          course: courses,
          submission: assignmentSubmissions,
        })
        .from(assignments)
        .leftJoin(courses, eq(assignments.courseId, courses.id))
        .leftJoin(
          assignmentSubmissions,
          and(
            eq(assignments.id, assignmentSubmissions.assignmentId),
            eq(assignmentSubmissions.studentId, req.session.user.id)
          )
        )
        .where(inArray(assignments.courseId, courseIds))
        .orderBy(desc(assignments.dueDate));

      res.json(allAssignments);
    })
  );

  // Create assignment (faculty)
  apiRouter.post(
    "/assignments",
    requireRole("faculty", "admin"),
    asyncHandler(async (req: Request, res: Response) => {
      const [assignment] = await db
        .insert(assignments)
        .values({ ...req.body, createdBy: req.session.user.id })
        .returning();
      res.status(201).json(assignment);
    })
  );

  // Submit assignment
  apiRouter.post(
    "/assignments/:id/submit",
    requireAuth,
    upload.single("file"),
    asyncHandler(async (req: Request, res: Response) => {
      if (!req.file) {
        return res.status(400).json({ error: "No file uploaded" });
      }

      const [submission] = await db
        .insert(assignmentSubmissions)
        .values({
          assignmentId: req.params.id,
          studentId: req.session.user.id,
          submissionUrl: `/uploads/${req.file.filename}`,
          status: "submitted",
        })
        .returning();

      res.status(201).json(submission);
    })
  );

  // Grade assignment (faculty)
  apiRouter.put(
    "/submissions/:id/grade",
    requireRole("faculty"),
    asyncHandler(async (req: Request, res: Response) => {
      const { marksObtained, feedback } = req.body;

      const [updated] = await db
        .update(assignmentSubmissions)
        .set({
          marksObtained,
          feedback,
          status: "graded",
          gradedAt: new Date(),
          gradedBy: req.session.user.id,
        })
        .where(eq(assignmentSubmissions.id, req.params.id))
        .returning();

      res.json(updated);
    })
  );

  // ==================== EXAMS ====================

  // Get upcoming exams
  apiRouter.get(
    "/exams/upcoming",
    requireAuth,
    asyncHandler(async (req: Request, res: Response) => {
      const enrolledCourses = await db
        .select({ courseId: courseEnrollments.courseId })
        .from(courseEnrollments)
        .where(eq(courseEnrollments.studentId, req.session.user.id));

      const courseIds = enrolledCourses.map((e) => e.courseId);

      const upcomingExams = await db
        .select({
          exam: exams,
          course: courses,
        })
        .from(exams)
        .leftJoin(courses, eq(exams.courseId, courses.id))
        .where(
          and(
            inArray(exams.courseId, courseIds),
            gte(exams.examDate, new Date())
          )
        )
        .orderBy(exams.examDate);

      res.json(upcomingExams);
    })
  );

  // Get exam results
  apiRouter.get(
    "/exams/results/me",
    requireAuth,
    asyncHandler(async (req: Request, res: Response) => {
      const results = await db
        .select({
          result: examResults,
          exam: exams,
          course: courses,
        })
        .from(examResults)
        .leftJoin(exams, eq(examResults.examId, exams.id))
        .leftJoin(courses, eq(exams.courseId, courses.id))
        .where(eq(examResults.studentId, req.session.user.id))
        .orderBy(desc(examResults.createdAt));

      res.json(results);
    })
  );

  // Create exam (faculty)
  apiRouter.post(
    "/exams",
    requireRole("faculty", "admin"),
    asyncHandler(async (req: Request, res: Response) => {
      const [exam] = await db.insert(exams).values(req.body).returning();
      res.status(201).json(exam);
    })
  );

  // Publish exam result (faculty)
  apiRouter.post(
    "/exams/:id/results",
    requireRole("faculty"),
    asyncHandler(async (req: Request, res: Response) => {
      const { studentId, marksObtained, grade, remarks } = req.body;

      const [result] = await db
        .insert(examResults)
        .values({
          examId: req.params.id,
          studentId,
          marksObtained,
          grade,
          remarks,
          publishedAt: new Date(),
        })
        .returning();

      res.status(201).json(result);
    })
  );

  // ==================== ATTENDANCE ====================

  // Get student's attendance
  apiRouter.get(
    "/attendance/me",
    requireAuth,
    asyncHandler(async (req: Request, res: Response) => {
      const { startDate, endDate, courseId } = req.query;

      let query = db
        .select({
          attendance: attendance,
          course: courses,
        })
        .from(attendance)
        .leftJoin(courses, eq(attendance.courseId, courses.id))
        .where(eq(attendance.studentId, req.session.user.id));

      const conditions = [eq(attendance.studentId, req.session.user.id)];

      if (startDate)
        conditions.push(gte(attendance.date, new Date(startDate as string)));
      if (endDate)
        conditions.push(lte(attendance.date, new Date(endDate as string)));
      if (courseId)
        conditions.push(eq(attendance.courseId, courseId as string));

      if (conditions.length > 1) {
        query = query.where(and(...conditions)) as any;
      }

      const records = await query.orderBy(desc(attendance.date));
      res.json(records);
    })
  );

  // Get attendance statistics
  apiRouter.get(
    "/attendance/stats",
    requireAuth,
    asyncHandler(async (req: Request, res: Response) => {
      const { courseId } = req.query;

      const result = await db.execute(sql`
      SELECT 
        COUNT(*) as total,
        SUM(CASE WHEN status = 'present' THEN 1 ELSE 0 END) as present,
        SUM(CASE WHEN status = 'absent' THEN 1 ELSE 0 END) as absent,
        SUM(CASE WHEN status = 'late' THEN 1 ELSE 0 END) as late
      FROM attendance
      WHERE student_id = ${req.session.user.id}
      ${courseId ? sql`AND course_id = ${courseId}` : sql``}
    `);

      res.json(result.rows[0]);
    })
  );

  // Mark attendance (faculty)
  apiRouter.post(
    "/attendance",
    requireRole("faculty"),
    asyncHandler(async (req: Request, res: Response) => {
      const [record] = await db
        .insert(attendance)
        .values({ ...req.body, markedBy: req.session.user.id })
        .returning();
      res.status(201).json(record);
    })
  );

  // ==================== FEE PAYMENTS ====================

  // Get student's fee payments
  apiRouter.get(
    "/fees/me",
    requireAuth,
    asyncHandler(async (req: Request, res: Response) => {
      const payments = await db
        .select()
        .from(feePayments)
        .where(eq(feePayments.studentId, req.session.user.id))
        .orderBy(desc(feePayments.createdAt));
      res.json(payments);
    })
  );

  // Get fee structure
  apiRouter.get(
    "/fees/structure",
    requireAuth,
    asyncHandler(async (req: Request, res: Response) => {
      const user = await db.query.users.findFirst({
        where: eq(users.id, req.session.user.id),
      });

      const structure = await db
        .select()
        .from(feeStructure)
        .where(
          and(
            eq(feeStructure.semester, user.currentSemester),
            eq(feeStructure.department, user.department)
          )
        )
        .limit(1);

      res.json(structure[0] || null);
    })
  );

  // Create payment
  apiRouter.post(
    "/fees/payment",
    requireAuth,
    asyncHandler(async (req: Request, res: Response) => {
      const [payment] = await db
        .insert(feePayments)
        .values({
          ...req.body,
          studentId: req.session.user.id,
          status: "pending",
          receiptNumber: `REC-${Date.now()}`,
        })
        .returning();
      res.status(201).json(payment);
    })
  );

  // Update payment status (admin)
  apiRouter.put(
    "/fees/payment/:id",
    requireRole("admin"),
    asyncHandler(async (req: Request, res: Response) => {
      const { status, paidDate, transactionId } = req.body;

      const [updated] = await db
        .update(feePayments)
        .set({ status, paidDate, transactionId })
        .where(eq(feePayments.id, req.params.id))
        .returning();

      res.json(updated);
    })
  );

  // Get receipt
  apiRouter.get(
    "/fees/receipt/:id",
    requireAuth,
    asyncHandler(async (req: Request, res: Response) => {
      const payment = await db.query.feePayments.findFirst({
        where: eq(feePayments.id, req.params.id),
      });

      if (!payment) {
        return res.status(404).json({ error: "Payment not found" });
      }

      if (
        payment.studentId !== req.session.user.id &&
        req.session.user.role !== "admin"
      ) {
        return res.status(403).json({ error: "Forbidden" });
      }

      res.json(payment);
    })
  );

  // ==================== SCHOLARSHIPS ====================

  // Get all scholarships
  apiRouter.get(
    "/scholarships",
    requireAuth,
    asyncHandler(async (req: Request, res: Response) => {
      const { category, provider } = req.query;

      let query = db.select().from(scholarships);
      const conditions = [];

      if (category)
        conditions.push(eq(scholarships.category, category as string));
      if (provider)
        conditions.push(eq(scholarships.provider, provider as string));

      if (conditions.length > 0) {
        query = query.where(and(...conditions)) as any;
      }

      const allScholarships = await query
        .where(gte(scholarships.deadline, new Date()))
        .orderBy(scholarships.deadline);

      res.json(allScholarships);
    })
  );

  // Get student's scholarship applications
  apiRouter.get(
    "/scholarships/applications/me",
    requireAuth,
    asyncHandler(async (req: Request, res: Response) => {
      const applications = await db
        .select({
          application: scholarshipApplications,
          scholarship: scholarships,
        })
        .from(scholarshipApplications)
        .leftJoin(
          scholarships,
          eq(scholarshipApplications.scholarshipId, scholarships.id)
        )
        .where(eq(scholarshipApplications.studentId, req.session.user.id))
        .orderBy(desc(scholarshipApplications.applicationDate));

      res.json(applications);
    })
  );

  // Apply for scholarship
  apiRouter.post(
    "/scholarships/apply",
    requireAuth,
    upload.single("documents"),
    asyncHandler(async (req: Request, res: Response) => {
      const { scholarshipId } = req.body;

      // Check if already applied
      const existing = await db.query.scholarshipApplications.findFirst({
        where: and(
          eq(scholarshipApplications.scholarshipId, scholarshipId),
          eq(scholarshipApplications.studentId, req.session.user.id)
        ),
      });

      if (existing) {
        return res
          .status(400)
          .json({ error: "Already applied for this scholarship" });
      }

      const [application] = await db
        .insert(scholarshipApplications)
        .values({
          scholarshipId,
          studentId: req.session.user.id,
          documentsUrl: req.file ? `/uploads/${req.file.filename}` : null,
          status: "applied",
        })
        .returning();

      res.status(201).json(application);
    })
  );

  // Update scholarship application status (admin)
  apiRouter.put(
    "/scholarships/applications/:id",
    requireRole("admin", "faculty"),
    asyncHandler(async (req: Request, res: Response) => {
      const { status, remarks, approvedAmount } = req.body;

      const [updated] = await db
        .update(scholarshipApplications)
        .set({
          status,
          remarks,
          approvedAmount,
          reviewedBy: req.session.user.id,
          reviewedAt: new Date(),
        })
        .where(eq(scholarshipApplications.id, req.params.id))
        .returning();

      res.json(updated);
    })
  );

  // ==================== LIBRARY ====================

  // Search books
  apiRouter.get(
    "/library/books",
    requireAuth,
    asyncHandler(async (req: Request, res: Response) => {
      const { search, category } = req.query;

      let query = db.select().from(libraryBooks);
      const conditions = [];

      if (search) {
        const searchPattern = `%${search}%`;
        conditions.push(
          sql`${libraryBooks.title} ILIKE ${searchPattern} OR ${libraryBooks.author} ILIKE ${searchPattern}`
        );
      }
      if (category)
        conditions.push(eq(libraryBooks.category, category as string));

      if (conditions.length > 0) {
        query = query.where(and(...conditions)) as any;
      }

      const books = await query;
      res.json(books);
    })
  );

  // Get student's issued books
  apiRouter.get(
    "/library/issues/me",
    requireAuth,
    asyncHandler(async (req: Request, res: Response) => {
      const issues = await db
        .select({
          issue: libraryIssues,
          book: libraryBooks,
        })
        .from(libraryIssues)
        .leftJoin(libraryBooks, eq(libraryIssues.bookId, libraryBooks.id))
        .where(eq(libraryIssues.studentId, req.session.user.id))
        .orderBy(desc(libraryIssues.issueDate));

      res.json(issues);
    })
  );

  // Issue book (staff)
  apiRouter.post(
    "/library/issue",
    requireRole("staff", "admin"),
    asyncHandler(async (req: Request, res: Response) => {
      const { bookId, studentId, dueDate } = req.body;

      // Check book availability
      const book = await db.query.libraryBooks.findFirst({
        where: eq(libraryBooks.id, bookId),
      });

      if (!book || book.availableCopies <= 0) {
        return res.status(400).json({ error: "Book not available" });
      }

      const [issue] = await db
        .insert(libraryIssues)
        .values({
          bookId,
          studentId,
          dueDate: new Date(dueDate),
          issuedBy: req.session.user.id,
          status: "issued",
        })
        .returning();

      // Update book availability
      await db
        .update(libraryBooks)
        .set({ availableCopies: book.availableCopies - 1 })
        .where(eq(libraryBooks.id, bookId));

      res.status(201).json(issue);
    })
  );

  // Return book (staff)
  apiRouter.put(
    "/library/return/:id",
    requireRole("staff", "admin"),
    asyncHandler(async (req: Request, res: Response) => {
      const { fine } = req.body;

      const issue = await db.query.libraryIssues.findFirst({
        where: eq(libraryIssues.id, req.params.id),
      });

      if (!issue) {
        return res.status(404).json({ error: "Issue record not found" });
      }

      const [updated] = await db
        .update(libraryIssues)
        .set({
          returnDate: new Date(),
          fine: fine || 0,
          status: "available",
        })
        .where(eq(libraryIssues.id, req.params.id))
        .returning();

      // Update book availability
      await db.execute(sql`
      UPDATE library_books 
      SET available_copies = available_copies + 1 
      WHERE id = ${issue.bookId}
    `);

      res.json(updated);
    })
  );

  // ==================== EVENTS ====================

  // Get all events
  apiRouter.get(
    "/events",
    requireAuth,
    asyncHandler(async (req: Request, res: Response) => {
      const { category, status } = req.query;

      let query = db.select().from(events);
      const conditions = [];

      if (category) conditions.push(eq(events.category, category as string));
      if (status) conditions.push(eq(events.status, status as any));

      if (conditions.length > 0) {
        query = query.where(and(...conditions)) as any;
      }

      const allEvents = await query.orderBy(events.eventDate);
      res.json(allEvents);
    })
  );

  // Get upcoming events
  apiRouter.get(
    "/events/upcoming",
    requireAuth,
    asyncHandler(async (req: Request, res: Response) => {
      const upcomingEvents = await db
        .select()
        .from(events)
        .where(
          and(gte(events.eventDate, new Date()), eq(events.status, "upcoming"))
        )
        .orderBy(events.eventDate)
        .limit(10);

      res.json(upcomingEvents);
    })
  );

  // Create event (faculty/admin)
  apiRouter.post(
    "/events",
    requireRole("faculty", "admin"),
    asyncHandler(async (req: Request, res: Response) => {
      const [event] = await db
        .insert(events)
        .values({ ...req.body, organizer: req.session.user.id })
        .returning();
      res.status(201).json(event);
    })
  );

  // RSVP to event
  apiRouter.post(
    "/events/:id/rsvp",
    requireAuth,
    asyncHandler(async (req: Request, res: Response) => {
      const { status: rsvpStatus } = req.body;

      // Check if already RSVPed
      const existing = await db.query.eventRSVP.findFirst({
        where: and(
          eq(eventRSVP.eventId, req.params.id),
          eq(eventRSVP.userId, req.session.user.id)
        ),
      });

      if (existing) {
        // Update existing RSVP
        const [updated] = await db
          .update(eventRSVP)
          .set({ status: rsvpStatus })
          .where(eq(eventRSVP.id, existing.id))
          .returning();
        return res.json(updated);
      }

      // Create new RSVP
      const [rsvp] = await db
        .insert(eventRSVP)
        .values({
          eventId: req.params.id,
          userId: req.session.user.id,
          status: rsvpStatus,
        })
        .returning();

      res.status(201).json(rsvp);
    })
  );

  // ==================== NOTICES ====================

  // Get all notices
  apiRouter.get(
    "/notices",
    requireAuth,
    asyncHandler(async (req: Request, res: Response) => {
      const { category, priority } = req.query;

      let query = db.select().from(notices);
      const conditions = [eq(notices.status, "published")];

      if (category) conditions.push(eq(notices.category, category as string));
      if (priority) conditions.push(eq(notices.priority, priority as any));

      query = query.where(and(...conditions)) as any;

      const allNotices = await query
        .orderBy(desc(notices.priority), desc(notices.publishedAt))
        .limit(50);

      res.json(allNotices);
    })
  );

  // Mark notice as read
  apiRouter.post(
    "/notices/:id/read",
    requireAuth,
    asyncHandler(async (req: Request, res: Response) => {
      const [read] = await db
        .insert(noticeReads)
        .values({
          noticeId: req.params.id,
          userId: req.session.user.id,
        })
        .returning();
      res.json(read);
    })
  );

  // Create notice (faculty/admin)
  apiRouter.post(
    "/notices",
    requireRole("faculty", "admin"),
    asyncHandler(async (req: Request, res: Response) => {
      const [notice] = await db
        .insert(notices)
        .values({ ...req.body, publishedBy: req.session.user.id })
        .returning();
      res.status(201).json(notice);
    })
  );

  // ==================== LOST & FOUND ====================

  // Get lost & found items
  apiRouter.get(
    "/lost-found",
    requireAuth,
    asyncHandler(async (req: Request, res: Response) => {
      const { type, category, status } = req.query;

      let query = db.select().from(lostFound);
      const conditions = [];

      if (type) conditions.push(eq(lostFound.type, type as any));
      if (category) conditions.push(eq(lostFound.category, category as string));
      if (status) conditions.push(eq(lostFound.status, status as any));

      if (conditions.length > 0) {
        query = query.where(and(...conditions)) as any;
      }

      const items = await query.orderBy(desc(lostFound.dateReported));
      res.json(items);
    })
  );

  // Report lost/found item
  apiRouter.post(
    "/lost-found",
    requireAuth,
    upload.single("image"),
    asyncHandler(async (req: Request, res: Response) => {
      const [item] = await db
        .insert(lostFound)
        .values({
          ...req.body,
          reportedBy: req.session.user.id,
          imageUrl: req.file ? `/uploads/${req.file.filename}` : null,
          status: req.body.type,
        })
        .returning();
      res.status(201).json(item);
    })
  );

  // Claim item
  apiRouter.put(
    "/lost-found/:id/claim",
    requireAuth,
    asyncHandler(async (req: Request, res: Response) => {
      const [updated] = await db
        .update(lostFound)
        .set({
          claimedBy: req.session.user.id,
          status: "returned",
        })
        .where(eq(lostFound.id, req.params.id))
        .returning();
      res.json(updated);
    })
  );

  // ==================== GRIEVANCES ====================

  // Get student's grievances
  apiRouter.get(
    "/grievances/me",
    requireAuth,
    asyncHandler(async (req: Request, res: Response) => {
      const myGrievances = await db
        .select()
        .from(grievances)
        .where(eq(grievances.studentId, req.session.user.id))
        .orderBy(desc(grievances.submittedAt));
      res.json(myGrievances);
    })
  );

  // Submit grievance
  apiRouter.post(
    "/grievances",
    requireAuth,
    upload.single("attachment"),
    asyncHandler(async (req: Request, res: Response) => {
      const [grievance] = await db
        .insert(grievances)
        .values({
          ...req.body,
          studentId: req.session.user.id,
          attachmentUrl: req.file ? `/uploads/${req.file.filename}` : null,
        })
        .returning();
      res.status(201).json(grievance);
    })
  );

  // Update grievance status (admin)
  apiRouter.put(
    "/grievances/:id",
    requireRole("admin", "faculty"),
    asyncHandler(async (req: Request, res: Response) => {
      const { status, resolution, assignedTo } = req.body;

      const updateData: any = { status, resolution, assignedTo };
      if (status === "resolved") {
        updateData.resolvedAt = new Date();
      }

      const [updated] = await db
        .update(grievances)
        .set(updateData)
        .where(eq(grievances.id, req.params.id))
        .returning();

      res.json(updated);
    })
  );

  // ==================== ACTIVITIES & PORTFOLIO ====================

  // Get student's activities
  apiRouter.get(
    "/activities/me",
    requireAuth,
    asyncHandler(async (req: Request, res: Response) => {
      const myActivities = await db
        .select()
        .from(activities)
        .where(eq(activities.studentId, req.session.user.id))
        .orderBy(desc(activities.activityDate));
      res.json(myActivities);
    })
  );

  // Submit activity
  apiRouter.post(
    "/activities",
    requireAuth,
    upload.single("certificate"),
    asyncHandler(async (req: Request, res: Response) => {
      const [activity] = await db
        .insert(activities)
        .values({
          ...req.body,
          studentId: req.session.user.id,
          certificateUrl: req.file ? `/uploads/${req.file.filename}` : null,
          status: "pending",
        })
        .returning();
      res.status(201).json(activity);
    })
  );

  // Approve/Reject activity (faculty)
  apiRouter.put(
    "/activities/:id/verify",
    requireRole("faculty", "admin"),
    asyncHandler(async (req: Request, res: Response) => {
      const { status, feedback, skillCredits } = req.body;

      const [updated] = await db
        .update(activities)
        .set({
          status,
          feedback,
          skillCredits,
          verifiedBy: req.session.user.id,
          verificationDate: new Date(),
        })
        .where(eq(activities.id, req.params.id))
        .returning();

      res.json(updated);
    })
  );

  // ==================== GOALS & ACHIEVEMENTS ====================

  // Get student's goals
  apiRouter.get(
    "/goals/me",
    requireAuth,
    asyncHandler(async (req: Request, res: Response) => {
      const myGoals = await db
        .select()
        .from(goals)
        .where(eq(goals.studentId, req.session.user.id))
        .orderBy(desc(goals.targetDate));
      res.json(myGoals);
    })
  );

  // Create goal
  apiRouter.post(
    "/goals",
    requireAuth,
    asyncHandler(async (req: Request, res: Response) => {
      const [goal] = await db
        .insert(goals)
        .values({ ...req.body, studentId: req.session.user.id })
        .returning();
      res.status(201).json(goal);
    })
  );

  // Update goal progress
  apiRouter.put(
    "/goals/:id",
    requireAuth,
    asyncHandler(async (req: Request, res: Response) => {
      const [updated] = await db
        .update(goals)
        .set(req.body)
        .where(
          and(
            eq(goals.id, req.params.id),
            eq(goals.studentId, req.session.user.id)
          )
        )
        .returning();
      res.json(updated);
    })
  );

  // Get achievements
  apiRouter.get(
    "/achievements/me",
    requireAuth,
    asyncHandler(async (req: Request, res: Response) => {
      const myAchievements = await db
        .select()
        .from(achievements)
        .where(eq(achievements.studentId, req.session.user.id))
        .orderBy(desc(achievements.achievedDate));
      res.json(myAchievements);
    })
  );

  // Add achievement
  apiRouter.post(
    "/achievements",
    requireAuth,
    upload.single("certificate"),
    asyncHandler(async (req: Request, res: Response) => {
      const [achievement] = await db
        .insert(achievements)
        .values({
          ...req.body,
          studentId: req.session.user.id,
          certificateUrl: req.file ? `/uploads/${req.file.filename}` : null,
        })
        .returning();
      res.status(201).json(achievement);
    })
  );

  // ==================== NOTIFICATIONS ====================

  // Get user's notifications
  apiRouter.get(
    "/notifications/me",
    requireAuth,
    asyncHandler(async (req: Request, res: Response) => {
      const myNotifications = await db
        .select()
        .from(notifications)
        .where(eq(notifications.userId, req.session.user.id))
        .orderBy(desc(notifications.createdAt))
        .limit(50);
      res.json(myNotifications);
    })
  );

  // Mark notification as read
  apiRouter.put(
    "/notifications/:id/read",
    requireAuth,
    asyncHandler(async (req: Request, res: Response) => {
      const [updated] = await db
        .update(notifications)
        .set({ isRead: true })
        .where(
          and(
            eq(notifications.id, req.params.id),
            eq(notifications.userId, req.session.user.id)
          )
        )
        .returning();
      res.json(updated);
    })
  );

  // Mark all as read
  apiRouter.put(
    "/notifications/read-all",
    requireAuth,
    asyncHandler(async (req: Request, res: Response) => {
      await db
        .update(notifications)
        .set({ isRead: true })
        .where(eq(notifications.userId, req.session.user.id));
      res.json({ message: "All notifications marked as read" });
    })
  );

  // ==================== ANALYTICS & DASHBOARD ====================

  // Get dashboard stats
  apiRouter.get(
    "/dashboard/stats",
    requireAuth,
    asyncHandler(async (req: Request, res: Response) => {
      const user = await db.query.users.findFirst({
        where: eq(users.id, req.session.user.id),
      });

      // Get attendance percentage
      const attendanceResult = await db.execute(sql`
      SELECT 
        COUNT(*) as total,
        SUM(CASE WHEN status = 'present' THEN 1 ELSE 0 END) as present
      FROM attendance
      WHERE student_id = ${req.session.user.id}
    `);

      const attendanceData = attendanceResult.rows[0] as any;
      const attendancePercentage =
        attendanceData.total > 0
          ? ((attendanceData.present / attendanceData.total) * 100).toFixed(1)
          : 0;

      // Get pending assignments
      const enrolledCourses = await db
        .select({ courseId: courseEnrollments.courseId })
        .from(courseEnrollments)
        .where(eq(courseEnrollments.studentId, req.session.user.id));

      const courseIds = enrolledCourses.map((e) => e.courseId);

      const pendingAssignments = await db
        .select()
        .from(assignments)
        .where(
          and(
            inArray(assignments.courseId, courseIds),
            gte(assignments.dueDate, new Date())
          )
        );

      // Get upcoming exams
      const upcomingExamsCount = await db
        .select()
        .from(exams)
        .where(
          and(
            inArray(exams.courseId, courseIds),
            gte(exams.examDate, new Date())
          )
        );

      // Get pending activities
      const pendingActivitiesCount = await db
        .select()
        .from(activities)
        .where(
          and(
            eq(activities.studentId, req.session.user.id),
            eq(activities.status, "pending")
          )
        );

      res.json({
        cgpa: user?.cgpa || 0,
        attendancePercentage,
        pendingAssignments: pendingAssignments.length,
        upcomingExams: upcomingExamsCount.length,
        pendingActivities: pendingActivitiesCount.length,
      });
    })
  );

  // Register all routes under /api prefix
  app.use("/api", apiRouter);

  console.log("✅ All API routes registered successfully");
}
